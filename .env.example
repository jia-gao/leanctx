# .env.example — copy to .env and fill in your keys
# .env is in .gitignore and must never be committed.

# ── Required for LongBench accuracy evaluation (Sprint 8 / P1b) ───────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Eval model for the Phase 1 benchmark harness ─────────────────────────
# Format: <provider>/<model-id>
# Supported providers: anthropic | openai
BENCHMARK_EVAL_PROVIDER=anthropic
BENCHMARK_EVAL_MODEL=claude-sonnet-4-6

# ── Optional: pre-started leanctx sidecar (auto-started if not reachable) ─
# LEANCTX_SIDECAR_URL=http://127.0.0.1:8459

# ── Optional: force GPU/device for Lingua (auto-detected if blank) ─────────
# LEANCTX_SERVER_LINGUA_DEVICE=cuda
# LEANCTX_SERVER_LINGUA_DEVICE=mps

OPENROUTER_API_KEY=sk-or-...